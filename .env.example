# Stellar Stream Hive — environment configuration
#
# Copy this file to `.env.local` and fill in the values below.

# --- Contract IDs ---------------------------------------------------------
# These are NOT yet available. The contracts repo (stellar-stream-hive-contract)
# is being deployed to Stellar testnet in parallel with this frontend.
# Fill these in after deployment — see DEPLOYMENTS.md in:
#   https://github.com/Stellar-Hive/stellar-stream-hive-contract
#
# Do NOT invent or hardcode placeholder contract IDs anywhere in the app.
# Until these are set, contract-calling features will show a clear
# "not yet configured" error state instead of failing silently.

NEXT_PUBLIC_STREAM_CONTRACT_ID=
NEXT_PUBLIC_VAULT_CONTRACT_ID=
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=

# --- Network ---------------------------------------------------------------
# Stellar network passphrase and RPC/Horizon endpoints. Defaults target testnet.

NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Stellar Stream Hive API -------------------------------------------------
# Registry/indexer API used for platform-wide stats on the landing page and
# for listing streams by sender/recipient. See:
#   https://github.com/Stellar-Hive/stellar-stream-hive-api
# If unset, the app falls back to a graceful empty/loading state rather than
# fabricating numbers.

NEXT_PUBLIC_API_BASE_URL=
